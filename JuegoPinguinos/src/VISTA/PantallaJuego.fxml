<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="VISTA.PantallaJuego"
            prefWidth="750" prefHeight="650"
            style="-fx-background-color: #1a1a2e;">

    <!-- TOP: MenuBar -->
    <top>
        <MenuBar>
            <Menu text="Juego">
                <MenuItem fx:id="newGame"  text="Nueva Partida" onAction="#handleNewGame"/>
                <MenuItem fx:id="saveGame" text="Guardar"       onAction="#handleSaveGame"/>
                <MenuItem fx:id="loadGame" text="Cargar"        onAction="#handleLoadGame"/>
                <MenuItem fx:id="quitGame" text="Salir"         onAction="#handleQuitGame"/>
            </Menu>
        </MenuBar>
    </top>

    <!-- CENTER: Tauler -->
    <center>
        <VBox alignment="CENTER" spacing="5">
            <padding><Insets top="10" bottom="10" left="10" right="10"/></padding>

            <Text text="🐧 Tablero de Juego" style="-fx-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

            <GridPane fx:id="tablero"
                      gridLinesVisible="true"
                      style="-fx-background-color: #16213e;"
                      prefWidth="400" prefHeight="500">

                <!-- Jugadors (cercles) a posició inicial 0,0 -->
                <Circle fx:id="P1" radius="15" fill="#e74c3c"
                        GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Circle fx:id="P2" radius="15" fill="#3498db"
                        GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Circle fx:id="P3" radius="15" fill="#2ecc71"
                        GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <Circle fx:id="P4" radius="15" fill="#f39c12"
                        GridPane.rowIndex="0" GridPane.columnIndex="3"/>
            </GridPane>

            <!-- Resultat del dau -->
            <Text fx:id="dadoResultText"
                  text="Tira el dado para empezar"
                  style="-fx-fill: #f0f0f0; -fx-font-size: 14px;"/>

            <!-- Esdeveniments -->
            <Text fx:id="eventos"
                  text=""
                  style="-fx-fill: #f39c12; -fx-font-size: 13px;"/>
        </VBox>
    </center>

    <!-- RIGHT: Panell d'inventari i botons -->
    <right>
        <VBox spacing="12" alignment="TOP_CENTER"
              style="-fx-background-color: #16213e; -fx-padding: 15;">

            <Text text="🎲 Acciones" style="-fx-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>

            <Button fx:id="dado"
                    text="Tirar Dado"
                    onAction="#handleDado"
                    maxWidth="Infinity"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10;"/>

            <Text text="─────────────" style="-fx-fill: #444;"/>
            <Text text="🎒 Inventario" style="-fx-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>

            <!-- Dado Ràpid -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="rapido" text="Usar" onAction="#handleRapido"
                        style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-background-radius: 6;"/>
                <Text fx:id="rapido_t" text="Dado Rápido: 0"
                      style="-fx-fill: #cccccc; -fx-font-size: 12px;"/>
            </HBox>

            <!-- Dado Lent -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="lento" text="Usar" onAction="#handleLento"
                        style="-fx-background-color: #1abc9c; -fx-text-fill: white; -fx-background-radius: 6;"/>
                <Text fx:id="lento_t" text="Dado Lento: 0"
                      style="-fx-fill: #cccccc; -fx-font-size: 12px;"/>
            </HBox>

            <!-- Peixos -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="peces" text="Usar" onAction="#handlePeces"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 6;"/>
                <Text fx:id="peces_t" text="Peces: 0"
                      style="-fx-fill: #cccccc; -fx-font-size: 12px;"/>
            </HBox>

            <!-- Boles de neu -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="nieve" text="Usar" onAction="#handleNieve"
                        style="-fx-background-color: #ecf0f1; -fx-text-fill: #333; -fx-background-radius: 6;"/>
                <Text fx:id="nieve_t" text="Bolas Nieve: 0"
                      style="-fx-fill: #cccccc; -fx-font-size: 12px;"/>
            </HBox>

        </VBox>
    </right>

</BorderPane>
